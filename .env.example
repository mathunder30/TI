NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=mysql://portal_app:change-this-password@127.0.0.1:3306/sao_camilo_portal
SHADOW_DATABASE_URL=mysql://portal_app:change-this-password@127.0.0.1:3306/sao_camilo_portal_shadow
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters

# Configure each provider completely, or leave its fields empty to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/apple/callback

# SMTP is required for email verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
VITE_API_BASE_URL=

# Private ticket attachments are stored outside the frontend/public directory.
ATTACHMENT_STORAGE_DIR=../private-attachments
ATTACHMENT_MAX_SIZE_BYTES=10485760
ATTACHMENT_MAX_PER_TICKET=5
